{
  "openapi": "3.0.3",
  "info": {
    "title": "PCMMAD Laboratory Runtime Actions",
    "version": "11.0.0-actions-compat",
    "description": "Importer-conservative eight-operation Custom GPT Actions projection. The server-side canonical v11 schema remains authoritative for validation and currentness."
  },
  "servers": [
    {
      "url": "https://replace-with-active-ngrok-url.invalid"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/lab/vnext/orient": {
      "post": {
        "operationId": "orientCapabilities",
        "summary": "Orient to relevant live capabilities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "goal": {
                    "type": "string",
                    "description": "Natural-language goal used only to rank live capabilities."
                  },
                  "query": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "effect_classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "include_mutating": {
                    "type": "boolean"
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "compact",
                      "full"
                    ]
                  },
                  "max_capabilities": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 900
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/invoke": {
      "post": {
        "operationId": "invokeCapability",
        "summary": "Invoke one current native capability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "capability"
                ],
                "properties": {
                  "capability": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "authority": {
                    "type": "object",
                    "description": "Optional Runtime authority envelope. Authority is separate from arguments and is validated by the server.",
                    "additionalProperties": true
                  },
                  "expected_contract_digest": {
                    "type": "string",
                    "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                  },
                  "lease": {
                    "type": "object",
                    "description": "Capability lease returned by orient. A lease proves discovery/currentness and does not grant authority.",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/batch": {
      "post": {
        "operationId": "flowCapabilities",
        "summary": "Run a bounded sequential native capability flow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "steps"
                ],
                "properties": {
                  "steps": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "required": [
                        "tool_name",
                        "expected_contract_digest"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "tool_name": {
                          "type": "string"
                        },
                        "payload": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "authority": {
                          "type": "object",
                          "description": "Optional Runtime authority envelope. Authority is separate from arguments and is validated by the server.",
                          "additionalProperties": true
                        },
                        "expected_contract_digest": {
                          "type": "string",
                          "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "stop_on_error": {
                    "type": "boolean"
                  },
                  "parallelism": {
                    "type": "integer",
                    "enum": [
                      1
                    ]
                  },
                  "background": {
                    "type": "boolean"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "store_result": {
                    "type": "boolean"
                  },
                  "result_handle_threshold_chars": {
                    "type": "integer"
                  },
                  "result_label": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/compose": {
      "post": {
        "operationId": "composePlan",
        "summary": "Compose and seal a bounded capability plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nodes"
                ],
                "properties": {
                  "goal": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "lease": {
                    "type": "object",
                    "description": "Capability lease returned by orient. A lease proves discovery/currentness and does not grant authority.",
                    "additionalProperties": true
                  },
                  "nodes": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "capability"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "capability": {
                          "type": "string"
                        },
                        "arguments": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "depends_on": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "expected_contract_digest": {
                          "type": "string",
                          "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                        },
                        "when": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "assertions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "stop_on_error": {
                    "type": "boolean"
                  },
                  "max_parallelism": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "max_cost_units": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 320,
                    "description": "Caller-declared static plan budget ceiling."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/execute": {
      "post": {
        "operationId": "executePlan",
        "summary": "Execute a sealed plan with separate authority",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "plan",
                  "expected_plan_digest"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "plan": {
                    "type": "object",
                    "description": "Sealed capability plan returned by compose. Plans are authority-neutral and revalidated by execute.",
                    "additionalProperties": true
                  },
                  "expected_plan_digest": {
                    "type": "string",
                    "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                  },
                  "authorities": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/observe": {
      "post": {
        "operationId": "observeRuntime",
        "summary": "Observe a bounded Runtime object",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "lease",
                      "plan",
                      "capability",
                      "effect_profile",
                      "result",
                      "continuation",
                      "job"
                    ]
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "capability": {
                    "type": "string"
                  },
                  "handle": {
                    "type": "string"
                  },
                  "job_id": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "metadata",
                      "preview",
                      "range",
                      "status",
                      "progress",
                      "wait",
                      "output"
                    ]
                  },
                  "lease": {
                    "type": "object",
                    "description": "Capability lease returned by orient. A lease proves discovery/currentness and does not grant authority.",
                    "additionalProperties": true
                  },
                  "plan": {
                    "type": "object",
                    "description": "Sealed capability plan returned by compose. Plans are authority-neutral and revalidated by execute.",
                    "additionalProperties": true
                  },
                  "expected_plan_digest": {
                    "type": "string",
                    "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                  },
                  "timeout_seconds": {
                    "type": "integer"
                  },
                  "max_bytes": {
                    "type": "integer"
                  },
                  "offset_bytes": {
                    "type": "integer"
                  },
                  "length_bytes": {
                    "type": "integer"
                  },
                  "preview_chars": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/resume": {
      "post": {
        "operationId": "resumeContinuation",
        "summary": "Resume a single-use blocked continuation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "continuation_handle",
                  "resume_token"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "continuation_handle": {
                    "type": "string"
                  },
                  "resume_token": {
                    "type": "string"
                  },
                  "expected_plan_digest": {
                    "type": "string",
                    "description": "Current 64-character lowercase SHA-256 contract/plan digest."
                  },
                  "authorities": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    },
    "/lab/vnext/transfer": {
      "post": {
        "operationId": "transferData",
        "summary": "Move binary or file data through transfer tickets",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "export.create",
                      "chunk.read",
                      "import.create",
                      "chunk.write",
                      "import.finalize",
                      "meta"
                    ]
                  },
                  "arguments": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "authority": {
                    "type": "object",
                    "description": "Optional Runtime authority envelope. Authority is separate from arguments and is validated by the server.",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bounded Runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Authority or approval required"
          },
          "404": {
            "description": "Runtime object not found"
          },
          "409": {
            "description": "Currentness, plan, lease, or continuation conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-GitHome-Key"
      }
    }
  }
}
